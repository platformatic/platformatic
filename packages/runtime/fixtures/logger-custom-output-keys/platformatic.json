{
  "$schema": "https://schemas.platformatic.dev/@platformatic/runtime/3.73.0.json",
  "entrypoint": "composer",
  "autoload": {
    "path": "../logger-options-base-message-key/services"
  },
  "server": {
    "hostname": "127.0.0.1",
    "port": "0"
  },
  "watch": false,
  "managementApi": false,
  "logger": {
    "level": "debug",
    "timestamp": "isoTime",
    "timestampKey": "timestamp",
    "levelKey": "severity",
    "messageKey": "message"
  }
}
