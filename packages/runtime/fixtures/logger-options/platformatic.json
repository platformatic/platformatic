{
  "$schema": "https://schemas.platformatic.dev/@platformatic/runtime/2.60.0.json",
  "watch": false,
  "autoload": {
    "path": "services"
  },
  "managementApi": false,
  "logger": {
    "level": "debug",
    "formatters": {
      "path": "logger-formatters.js"
    },
    "timestamp": "isoTime",
    "redact": {
      "paths": [
        "secret"
      ],
      "censor": "***HIDDEN***"
    }
  }
}
