{
  "$schema": "https://schemas.platformatic.dev/@platformatic/runtime/3.0.0.json",
  "watch": true,
  "autoload": {
    "path": "../services",
    "exclude": [
      "docs"
    ]
  },
  "logger": {
    "level": "info"
  },
  "health": {
    "enabled": false
  },
  "workers": {
    "dynamic": true,
    "gracePeriod": 1000,
    "total": 10
  }
}
