{
  "$schema": "https://schemas.platformatic.dev/@platformatic/runtime/2.48.0.json",
  "watch": false,
  "autoload": {
    "path": "./services"
  },
  "metrics": {
    "hostname": "127.0.0.1",
    "port": 9090,
    "readiness": {
      "endpoint": "/readiness",
      "success": {
        "statusCode": 202,
        "body": "All ready"
      },
      "fail": {
        "statusCode": 502,
        "body": "Not ready"
      }
    }
  }
}
