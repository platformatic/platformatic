{
  "$schema": "https://schemas.platformatic.dev/@platformatic/service/1.52.0.json",
  "server": {
    "hostname": "127.0.0.1",
    "port": "{PORT}"
  },
  "service": {
    "openapi": true
  },
  "plugins": {
    "paths": [
      "../monorepo/serviceApp/plugin.js"
    ]
  },
  "clients": [
    {
      "serviceId": "with-logger",
      "path": "../monorepo/serviceApp/with-logger",
      "url": "{PLT_WITH_LOGGER_URL}"
    }
  ],
  "watch": {
    "enabled": true
  }
}
