{
  "$schema": "https://schemas.platformatic.dev/@platformatic/runtime/2.48.0.json",
  "watch": false,
  "autoload": {
    "path": "./services"
  },
  "metrics": {
    "hostname": "127.0.0.1",
    "port": 9090,
    "liveness": {
      "endpoint": "/live",
      "success": {
        "statusCode": 201,
        "body": "All right"
      },
      "fail": {
        "statusCode": 501,
        "body": "No good"
      }
    }
  }
}
