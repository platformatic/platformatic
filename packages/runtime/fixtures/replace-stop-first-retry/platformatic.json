{
  "$schema": "https://schemas.platformatic.dev/@platformatic/runtime/2.6.0.json",
  "watch": false,
  "entrypoint": "main",
  "reuseTcpPorts": false,
  "restartOnError": 500,
  "server": {
    "hostname": "127.0.0.1",
    "port": 0
  },
  "applications": [
    {
      "id": "main",
      "path": "./main",
      "config": "platformatic.json"
    }
  ],
  "logger": {
    "level": "trace"
  }
}
