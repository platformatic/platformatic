{
  "$schema": "https://schemas.platformatic.dev/@platformatic/runtime/2.0.0.json",
  "autoload": {
    "path": "./services"
  },
  "logger": {
    "level": "error"
  },
  "restartOnError": 1000,
  "health": {
    "enabled": true,
    "interval": 1000,
    "gracePeriod": 1,
    "maxEventLoopDelay": 60000,
    "maxEventLoopDelayP99": 60000
  }
}
