{
  "$schema": "https://schemas.platformatic.dev/@platformatic/runtime/2.3.1.json",
  "logger": {
    "level": "error"
  },
  "services": [
    {
      "id": "api",
      "path": "./services/api",
      "tracing": {
        "instrumentations": [
          "@opentelemetry/instrumentation-express"
        ]
      }
    }
  ],
  "tracing": {
    "applicationName": "test-service",
    "version": "1.0.0",
    "exporter": {
      "type": "file"
    }
  }
}
