{
  "name": "@platformatic/nest",
  "version": "3.75.0",
  "description": "Platformatic Nest.js Capability",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "npm run test:types && node --test --test-reporter=cleaner-spec-reporter --test-concurrency=1 --test-timeout=2000000 test/*.test.js test/**/*.test.js",
    "test:types": "tstyche",
    "gen-schema": "node lib/schema.js > schema.json",
    "gen-types": "json2ts > config.d.ts < schema.json",
    "build": "npm run gen-schema && npm run gen-types",
    "prepublishOnly": "npm run build",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platformatic/platformatic.git"
  },
  "author": "Platformatic Inc. <oss@platformatic.dev> (https://platformatic.dev)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/platformatic/platformatic/issues"
  },
  "homepage": "https://github.com/platformatic/platformatic#readme",
  "dependencies": {
    "@platformatic/basic": "workspace:*",
    "@platformatic/foundation": "workspace:*",
    "@platformatic/generators": "workspace:*",
    "@platformatic/globals": "workspace:*",
    "get-port": "^7.1.0",
    "light-my-request": "^6.0.0",
    "pino-http": "^10.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/platform-fastify": "^12.0.0",
    "@platformatic/gateway": "workspace:*",
    "@platformatic/service": "workspace:*",
    "cleaner-spec-reporter": "^2.0.0",
    "eslint": "9",
    "json-schema-to-typescript": "^16.0.0",
    "neostandard": "^0.14.0",
    "tstyche": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
