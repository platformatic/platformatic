{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/fixtures/**"
  ],
  "rangeStrategy": "update-lockfile",
  "ignoreDeps": [
    "camelcase",
    "inquirer",
    "mysql",
    "swagger-ui-react",
    "leven",
    "ora",
    "graphiql"
  ],
  "prHourlyLimit": 3,
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "matchPackageNames": ["@opentelemetry/**"],
      "groupName": "opentelemetry packages",
      "groupSlug": "opentelemetry"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "timezone": "Europe/Rome",
  "schedule": [
    "* 0-6 * * *"
  ],
  "rebaseWhen": "conflicted"
}
