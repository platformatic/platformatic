{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/fixtures/**"
  ],
  "rangeStrategy": "update-lockfile",
  // Mirrors pnpm-workspace.yaml `minimumReleaseAge: 1440` (1440 minutes = 1 day).
  // Security updates bypass this check regardless.
  "minimumReleaseAge": "1 day",
  "ignoreDeps": [
    "camelcase",
    "inquirer",
    "mysql",
    "swagger-ui-react",
    "leven",
    "ora",
    "graphiql"
  ],
  "prHourlyLimit": 3,
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      // Matches pnpm-workspace.yaml `minimumReleaseAgeExclude: - '@platformatic/*'`
      "matchPackageNames": ["@platformatic/*"],
      "minimumReleaseAge": null
    },
    {
      // graphql 17 is blocked until @mercuriusjs/federation and @mercuriusjs/gateway support it
      // (mercurius-js/mercurius-federation#267). Keep allowing 16.x updates.
      "matchPackageNames": ["graphql"],
      "allowedVersions": "<17"
    },
    {
      // undici 8 is only used on v4 (#5124). Keep main (v3) on undici 7 until v4 is merged.
      "matchPackageNames": ["undici"],
      "allowedVersions": "<8"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "matchPackageNames": ["@opentelemetry/**"],
      "groupName": "opentelemetry packages",
      "groupSlug": "opentelemetry"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "timezone": "Europe/Rome",
  "schedule": [
    "* 0-6 * * *"
  ],
  "rebaseWhen": "conflicted"
}
